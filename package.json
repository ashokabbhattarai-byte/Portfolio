{
  "name": "ashok-bhattarai-portfolio",
  "version": "0.1.0",
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.5.8",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "packageManager": "bun@1.3.10",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@portfolio/web",
    "dev:api": "turbo run dev --filter=@portfolio/api",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "bun run --filter='@portfolio/api' db:generate",
    "db:migrate": "bun run --filter='@portfolio/api' db:migrate",
    "db:deploy": "bun run --filter='@portfolio/api' db:deploy",
    "db:seed": "bun run --filter='@portfolio/api' db:seed",
    "db:studio": "bun run --filter='@portfolio/api' db:studio"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver",
    "@prisma/client",
    "prisma",
    "argon2"
  ],
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "multer": "2.3.0",
    "deepmerge-ts": "8.0.0"
  }
}
