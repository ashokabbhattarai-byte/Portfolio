# ---------------------------------------------------------------------------
# Env is now per-app. Do NOT create a .env at the repo root.
# Copy each example to its app:
#   cp apps/api/.env.example apps/api/.env
#   cp apps/web/.env.example apps/web/.env
# See apps/api/.env.example and apps/web/.env.example for the full spec.
# Turborepo will expose both to tasks via globalEnv (turbo.json).
# ---------------------------------------------------------------------------
# This file is kept for reference only and is NOT loaded at runtime.
