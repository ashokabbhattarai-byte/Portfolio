# ---------------------------------------------------------------------------
# NestJS API – owns the database, auth, and storage
# Copy to .env in this folder:  cp .env.example .env  (inside apps/api)
# ---------------------------------------------------------------------------

# --- Database (Supabase / Prisma 6) -----------------------------------------
# Runtime uses the SESSION pooler (5432). Measured on this project
# (Nepal -> ap-northeast-2, ~160ms RTT):
#
#   5432 session mode      176ms per query  <- prepared statements work
#   6543 transaction mode  794ms per query  <- needs pgbouncer=true, 4x slower
#
# Session mode gives each pooled connection its own backend, so Prisma's
# prepared statements are safe and a query costs one round trip.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# Migrations use a direct or session-mode connection, separate from runtime.
DIRECT_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

# Bounded per-process client pool, sized against provider capacity and the
# number of API replicas. Supabase caps the SESSION pooler at 15 clients for
# this project; five leaves room for a rolling deploy, migrations and Studio.
# Exceeding it gives: FATAL: (EMAXCONNSESSION) max clients reached.
DATABASE_POOL_SIZE=5
DATABASE_CONNECT_TIMEOUT=5
# Must outlast the slowest transaction the app runs (scheduled publication,
# ~1s per article). At 5s, ordinary queueing surfaced as P2024 across the API.
DATABASE_POOL_TIMEOUT=15

# --- Server ---------------------------------------------------------------
API_PORT=4000
# Where the API can reach the web app (for on-demand revalidation)
WEB_URL=http://localhost:3000
NODE_ENV=development

# --- Auth (generate with: openssl rand -base64 48) -----------------------
# Two distinct secrets – a leaked access secret must not mint refresh tokens.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# --- First admin (seed only, when no admin exists) ------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Ashok Bhattarai

# --- Supabase Storage (bucket: portfolio-storage) -------------------------
SUPABASE_URL=https://vaxrgatdyazjvtugzstk.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=portfolio-storage

# --- Revalidation (shared with web – must match apps/web/.env) -------------
# Generate with: openssl rand -hex 32
REVALIDATE_SECRET=

# --- Media storage --------------------------------------------------------
# "supabase" (default, uses the bucket above) or "s3" for any S3-compatible
# provider such as Cloudflare R2, AWS S3 or Backblaze B2.
MEDIA_STORAGE_PROVIDER=supabase
# Required only when MEDIA_STORAGE_PROVIDER=s3:
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Public base URL objects are served from, e.g. https://media.example.com
MEDIA_PUBLIC_URL=

# --- Scheduled publishing -------------------------------------------------
# The scheduler runs inside the API process and publishes due articles even
# when no browser is open. Set to "false" on replicas that should not publish.
BLOG_SCHEDULER_ENABLED=true
BLOG_SCHEDULER_INTERVAL_MS=15000

# --- AI publishing API ----------------------------------------------------
# Per-key rate limit for /api/v1/ai.
AI_RATE_LIMIT=60
AI_RATE_WINDOW_MS=60000

# --- AI image generation (optional) ---------------------------------------
# Leave IMAGE_PROVIDER unset (or "none") to disable generation; agents then
# upload images or import them from a URL instead.
IMAGE_PROVIDER=none
IMAGE_PROVIDER_MODEL=gpt-image-1
OPENAI_API_KEY=
