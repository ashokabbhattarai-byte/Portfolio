# ---------------------------------------------------------------------------
# NestJS API – owns the database, auth, and storage
# Copy to .env in this folder:  cp .env.example .env  (inside apps/api)
# ---------------------------------------------------------------------------

# --- Database (Supabase) --------------------------------------------------
# Use the SESSION pooler (port 5432), not the transaction pooler (6543).
#
# The API is one long-lived NestJS process, which is what session mode is for:
# each pooled connection owns a Postgres backend, so Prisma's prepared
# statements work and a query costs one round trip.
#
# Measured on this project (Nepal -> ap-northeast-2, ~160ms RTT):
#   6543 + pgbouncer=true   776ms/query, 2500ms for a blog listing
#   6543 without the flag   fast, but FAILS: prepared statement "s6" does
#                           not exist (26000) as soon as queries overlap
#   5432 session mode       159ms/query, 965ms listing   <- correct AND fast
#
# connection_limit MUST stay small. Supabase caps the session pooler at
# 15 clients for this project:
#   FATAL: (EMAXCONNSESSION) max clients reached in session mode
#          - max clients are limited to pool_size: 15
# Five leaves room for migrations, Prisma Studio, and a `bun --watch` restart
# whose previous connections have not been reclaimed yet. Raising this to 10
# exhausted the pool and produced P1001 "can't reach database server".
DATABASE_URL=postgresql://postgres.vaxrgatdyazjvtugzstk:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=5&pool_timeout=15&connect_timeout=10
# Migrations need a non-pooled session; the same host on 5432 serves.
DIRECT_URL=postgresql://postgres.vaxrgatdyazjvtugzstk:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require

# --- Server ---------------------------------------------------------------
API_PORT=4000
# Where the API can reach the web app (for on-demand revalidation)
WEB_URL=http://localhost:3000
NODE_ENV=development

# --- Auth (generate with: openssl rand -base64 48) -----------------------
# Two distinct secrets – a leaked access secret must not mint refresh tokens.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# --- First admin (seed only, when no admin exists) ------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Ashok Bhattarai

# --- Supabase Storage (bucket: portfolio-storage) -------------------------
SUPABASE_URL=https://vaxrgatdyazjvtugzstk.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=portfolio-storage

# --- Revalidation (shared with web – must match apps/web/.env) -------------
# Generate with: openssl rand -hex 32
REVALIDATE_SECRET=

# --- Media storage --------------------------------------------------------
# "supabase" (default, uses the bucket above) or "s3" for any S3-compatible
# provider such as Cloudflare R2, AWS S3 or Backblaze B2.
MEDIA_STORAGE_PROVIDER=supabase
# Required only when MEDIA_STORAGE_PROVIDER=s3:
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Public base URL objects are served from, e.g. https://media.example.com
MEDIA_PUBLIC_URL=

# --- Scheduled publishing -------------------------------------------------
# The scheduler runs inside the API process and publishes due articles even
# when no browser is open. Set to "false" on replicas that should not publish.
BLOG_SCHEDULER_ENABLED=true
BLOG_SCHEDULER_INTERVAL_MS=15000

# --- AI publishing API ----------------------------------------------------
# Per-key rate limit for /api/v1/ai.
AI_RATE_LIMIT=60
AI_RATE_WINDOW_MS=60000

# --- AI image generation (optional) ---------------------------------------
# Leave IMAGE_PROVIDER unset (or "none") to disable generation; agents then
# upload images or import them from a URL instead.
IMAGE_PROVIDER=none
IMAGE_PROVIDER_MODEL=gpt-image-1
OPENAI_API_KEY=
