# ---------------------------------------------------------------------------
# Next.js Web – public portfolio + admin CMS
# Copy to .env in this folder:  cp .env.example .env  (inside apps/web)
# ---------------------------------------------------------------------------

# Final public origin – if empty, site is noindex and sitemap is empty
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the Next server reaches the Nest API (browser never uses this;
# it calls /api/* on its own origin and Next rewrites to API_URL)
API_URL=https://api.ashokbhattarai1.com.np

# Supabase – for next/image remotePatterns (storage CDN)
# Use the same project as the API; anon key is safe to expose if needed,
# but this app only needs the URL for image optimisation.
NEXT_PUBLIC_SUPABASE_URL=https://vaxrgatdyazjvtugzstk.supabase.co
SUPABASE_URL=https://vaxrgatdyazjvtugzstk.supabase.co

# Revalidation – must match apps/api/.env
REVALIDATE_SECRET=

# Proxy JWT verification – must match apps/api JWT_ACCESS_SECRET
# The /admin proxy verifies the access cookie for UX (security boundary is API)
JWT_ACCESS_SECRET=

NODE_ENV=development
